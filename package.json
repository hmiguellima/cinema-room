    "socket.io-client": "^4.4.0",
    "three": "^0.134.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.2",
    "@types/node": "^24.13.0",
    "@types/three": "^0.133.1",
    "@types/ws": "^8.18.1",
    "copy-webpack-plugin": "^9.1.0",
    "css-loader": "^5.2.6",
    "html-webpack-plugin": "^5.3.2",
    "prettier": "^2.3.2",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.2.3",
    "typescript": "^5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
